configuration {
	modi:				"drun";
	font:				"JetBrainsMono Nerd Font 11";
	show-icons:                     true;
	icon-theme: 			"Reversal-dark";
	display-drun: 			"";
	drun-display-format:            "{name}";
	sidebar-mode: 			false;
}

@theme "/dev/null"
@theme "~/.config/rofi/theme.rasi"

window {
  transparency:                "real";
	background-color:               transparent;            
	text-color:                     #ffffff;               
	border-radius:                  7px;
	width:			    	20%;
	padding: 			6px;
}

prompt {
	background-color:               @surface-container;            
	text-color:                     #ffffff;            
	enabled:			true;
	padding:			0.5% 32px 0% -0.5%;
	font:				"JetBrainsMono Nerd Font 12";
}

entry {
	background-color:               @surface-container;
	text-color:                     #ffffff;        
	placeholder:			"Search";
	placeholder-color:              #a0a0a0;     
	expand:                         true;
	padding:                        0.5% 0% 0% 0%;
}

inputbar {
	background-color:               @surface-container;
	children:			[ prompt, entry ];
	expand:                         false; border-radius:                  6px;
	margin:                         0%;
	padding:                        8px;
  border:                      1px;
  border-color:                rgba(255, 255, 255, 0.55);
  border-radius:               12px;
}

listview {
	background-color:               transparent;
	columns:                        1;
	lines:	                        5;
	cycle:                          false;
	dynamic:                        true;
	layout:                         vertical;
}

mainbox {
  background-color:            rgba(1, 1, 1, 0.4);
	children:                       [ inputbar, listview ];
	spacing:                       	2%;
	padding:                        2% 1% 2% 1%;
  border:                         1px;
  border-color:                   @primary;
  border-radius:                  12px;
}

element {
  background-color:            rgba(1, 1, 1, 0.1);
	text-color:                     #dddddd;
	orientation:                    horizontal;
  padding:                        6px 12px;
  margin:                         3px;
  border:                         1px;
  border-color:                   @primary;
  border-radius:                  12px;
}

element-icon {
	background-color:               transparent;
	size:                           30px;
	horizontal-align:	 	0.5;
}

element-text {
	background-color:               transparent;
	expand:                         true;
	margin:                         0.5% 0.5% -0.5% 0.5%;
}

element-text, element-icon {
	text-color:			inherit;
}

element selected {
	background-color:               @inverse-primary;
	text-color:                     #ffffff;
	border-radius:                  6px;
}
