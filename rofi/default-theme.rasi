configuration {
	modi:				"drun";
	font:				"JetBrainsMono Nerd Font 11";
	show-icons:                     true;
	icon-theme: 			"Reversal-dark";
	display-drun: 			"";
	drun-display-format:            "{name}";
	sidebar-mode: 			false;
}

@theme "/dev/null"
@theme "~/.config/rofi/theme.rasi"

window {
  transparency:                "real";
	background-color:               transparent;            
	text-color:                     #ffffff;               
	border-radius:                  7px;
	width:                          25%;
}


topbox {
    expand:                       false;
    orientation:                  vertical;
    children:                     [ inputbar ];
    padding:                      50px;
    background-image:             url("~/.config/Assets/current_anime.png", WIDTH);
    background-position:          center;
    border-radius:                12px 12px 0px 0px;
}

contentbox {
    expand:                       true;
	background-color:               transparent;
	orientation:                    vertical;
	children:                       [ listview ];
	padding:                        6px 12px 10px 12px;
}
mainbox {
  background-color:            rgba(15, 15, 20, 0.75);
  orientation:                 vertical;
	children:                    [ topbox, contentbox ];
	padding:                     0px;
  border:                      1px;
  border-color:                @primary;
  border-radius:                  12px;
}


prompt {
	background-color:               transparent;            
	text-color:                     #ffffff;            
	enabled:			true;
	padding:			0.5% 32px 0% -0.5%;
	font:				"JetBrainsMono Nerd Font 12";
}

entry {
	background-color:               transparent;
	text-color:                     #ffffff;        
	placeholder:			"Search";
	placeholder-color:              #cccccc;     
	expand:                         true;
	padding:                        0.5% 0% 0% 0%;
}

inputbar {
	background-color:               rgba(10, 10, 15, 0.55); 
	children:			[ prompt, entry ];
	expand:                         false; 
	border-radius:                  6px;
	margin:                         0%;
	padding:                        8px;
  border:                      1px;
  border-color:                rgba(255, 255, 255, 0.35);
  border-radius:               12px;
}

listview {
	background-color:               transparent;
	columns:                        1;
	lines:	                        5;
	cycle:                          false;
	dynamic:                        true;
	layout:                         vertical;
}

element {
  background-color:            rgba(1, 1, 1, 0.1);
	text-color:                     #dddddd;
	orientation:                    horizontal;
  padding:                        6px 12px;
  margin:                         3px;
  border:                         1px;
  border-color:                   @primary;
  border-radius:                  12px;
}

element-icon {
	background-color:               transparent;
	size:                           30px;
	horizontal-align:	 	0.5;
}

element-text {
	background-color:               transparent;
	expand:                         true;
	margin:                         0.5% 0.5% -0.5% 0.5%;
}

element-text, element-icon {
	text-color:			inherit;
}

element selected {
	background-color:               @inverse-primary;
	text-color:                     #ffffff;
	border-radius:                  6px;
}
