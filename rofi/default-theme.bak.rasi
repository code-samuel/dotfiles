configuration {
	modi:				"drun";
	font:				"JetBrainsMono Nerd Font 10";
	show-icons:                     true;
	icon-theme: 			"Reversal-dark";
	display-drun: 			"";
	drun-display-format:            "{name}";
	sidebar-mode: 			false;
}

@theme "/dev/null"
@theme "~/.config/rofi/theme.rasi"

window {
	background-color:               @surface-container-lowest;
	text-color:                     #ffffff;               
	border-radius:                  7px;
	width:			    	25%;
	padding: 			8px;
}

prompt {
	background-color:               @surface-container;            
	text-color:                     #ffffff;            
	enabled:			true;
	padding:			0.5% 32px 0% -0.5%;
	font:				"JetBrainsMono Nerd Font 10";
}

entry {
	background-color:               @surface-container;
	text-color:                     #ffffff;        
	placeholder:			"Search";
	placeholder-color:              #a0a0a0;     
	font:				"JetBrainsMono Nerd Font 10";
	expand:                         true;
	padding:                        0.5% 0% 0% 0%;
}

inputbar {
	background-color:               @surface-container;
	children:			[ prompt, entry ];
	expand:                         false;
	border-radius:                  6px;
	margin:                         0%;
	padding:                        10px;
}

listview {
	background-color:               transparent;
	columns:                        3;
	lines:	                        3;
	cycle:                          false;
	dynamic:                        true;
	layout:                         vertical;
}

mainbox {
	background-color:               transparent;
	children:                       [ inputbar, listview ];
	spacing:                       	2%;
	padding:                        2% 1% 2% 1%;
}

element {
	background-color:               transparent;
	text-color:                     #dddddd;   
	orientation:                    vertical;
	padding:                        2% 0% 2% 0%;
}

element-icon {
	background-color:               transparent;
	size:                           40px;
	horizontal-align:	 	0.5;
}

element-text {
	background-color:               transparent;
	expand:                         true;
	horizontal-align:               0.5;
	vertical-align:                 0.5;
	margin:                         0.5% 0.5% -0.5% 0.5%;
}

element-text, element-icon {
	background-color:		inherit;
	text-color:			inherit;
}

element selected {
	background-color:               @primary;
	text-color:                     #000000;
	border-radius:                  6px;
}
